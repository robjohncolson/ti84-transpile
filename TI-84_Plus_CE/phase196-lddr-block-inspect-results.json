      "body": "  \"092263:adl\": {\n    \"id\": \"092263:adl\",\n    \"startPc\": 598627,\n    \"mode\": \"adl\",\n    \"instructionCount\": 11,\n    \"instructions\": [\n      {\n        \"pc\": 598627,\n        \"mode\": \"adl\",\n        \"bytes\": \"ed b8\",\n        \"dasm\": \"lddr\",\n        \"tag\": \"lddr\",\n        \"length\": 2\n      },\n      {\n        \"pc\": 598629,\n        \"mode\": \"adl\",\n        \"bytes\": \"11 0b 15 d0\",\n        \"dasm\": \"ld de, 0xd0150b\",\n        \"tag\": \"ld-pair-imm\",\n        \"length\": 4\n      },\n      {\n        \"pc\": 598633,\n        \"mode\": \"adl\",\n        \"bytes\": \"c1\",\n        \"dasm\": \"pop bc\",\n        \"tag\": \"pop\",\n        \"length\": 1\n      },\n      {\n        \"pc\": 598634,\n        \"mode\": \"adl\",\n        \"bytes\": \"2a 08 15 d0\",\n        \"dasm\": \"ld hl, (0xd01508)\",\n        \"tag\": \"ld-pair-mem\",\n        \"length\": 4\n      },\n      {\n        \"pc\": 598638,\n        \"mode\": \"adl\",\n        \"bytes\": \"09\",\n        \"dasm\": \"add hl, bc\",\n        \"tag\": \"add-pair\",\n        \"length\": 1\n      },\n      {\n        \"pc\": 598639,\n        \"mode\": \"adl\",\n        \"bytes\": \"22 08 15 d0\",\n        \"dasm\": \"ld (0xd01508), hl\",\n        \"tag\": \"ld-pair-mem\",\n        \"length\": 4\n      },\n      {\n        \"pc\": 598643,\n        \"mode\": \"adl\",\n        \"bytes\": \"21 e6 08 d0\",\n        \"dasm\": \"ld hl, 0xd008e6\",\n        \"tag\": \"ld-pair-imm\",\n        \"length\": 4\n      },\n      {\n        \"pc\": 598647,\n        \"mode\": \"adl\",\n        \"bytes\": \"ed b0\",\n        \"dasm\": \"ldir\",\n        \"tag\": \"ldir\",\n        \"length\": 2\n      },\n      {\n        \"pc\": 598649,\n        \"mode\": \"adl\",\n        \"bytes\": \"21 0b 1d d0\",\n        \"dasm\": \"ld hl, 0xd01d0b\",\n        \"tag\": \"ld-pair-imm\",\n        \"length\": 4\n      },\n      {\n        \"pc\": 598653,\n        \"mode\": \"adl\",\n        \"bytes\": \"34\",\n        \"dasm\": \"inc (hl)\",\n        \"tag\": \"inc-reg\",\n        \"length\": 1\n      },\n      {\n        \"pc\": 598654,\n        \"mode\": \"adl\",\n        \"bytes\": \"c9\",\n        \"dasm\": \"ret\",\n        \"tag\": \"ret\",\n        \"length\": 1\n      }\n    ],\n    \"exits\": [\n      {\n        \"type\": \"return\"\n      }\n    ],\n    \"source\": \"function block_092263_adl(cpu) {\\n  // 0x092263  ed b8            lddr\\n  cpu.lddr();\\n  // 0x092265  11 0b 15 d0      ld de, 0xd0150b\\n  cpu.de = 0xd0150b;\\n  // 0x092269  c1               pop bc\\n  cpu.bc = cpu.pop();\\n  // 0x09226a  2a 08 15 d0      ld hl, (0xd01508)\\n  cpu.hl = cpu.read24(0xd01508);\\n  // 0x09226e  09               add hl, bc\\n  cpu.hl = cpu.addWord(cpu.hl, cpu.bc);\\n  // 0x09226f  22 08 15 d0      ld (0xd01508), hl\\n  cpu.write24(0xd01508, cpu.hl);\\n  // 0x092273  21 e6 08 d0      ld hl, 0xd008e6\\n  cpu.hl = 0xd008e6;\\n  // 0x092277  ed b0            ldir\\n  cpu.ldir();\\n  // 0x092279  21 0b 1d d0      ld hl, 0xd01d0b\\n  cpu.hl = 0xd01d0b;\\n  // 0x09227d  34               inc (hl)\\n  cpu.writeIndirect8('hl', cpu.inc8(cpu.readIndirect8('hl')));\\n  // 0x09227e  c9               ret\\n  return cpu.popReturn();\\n}\"\n  },",
